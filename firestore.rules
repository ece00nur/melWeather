rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /posts/{postId} {
      // Herkes (giriş yapmış herhangi bir kullanıcı) paylaşımları okuyabilir
      allow read: if request.auth != null;

      // Sadece kendi adına, gerekli alanları dolu olarak paylaşım oluşturabilir
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.imageBase64.size() > 0;

      // Sadece paylaşımı oluşturan kullanıcı silebilir, güncelleme kapalı
      allow update: if false;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
