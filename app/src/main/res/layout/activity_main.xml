<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_main">

    <!-- Camın gerçekten bulanıklaştıracağı gerçek fotoğraf arka planı -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_photo_sky" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFeed"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="90dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Speed Dial Floating Action Button: + basınca kamera/galeri mini butonları açılır -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="14dp"
        android:gravity="end"
        android:orientation="vertical">

        <!-- Mini buton: Galeri -->
        <FrameLayout
            android:id="@+id/btnMiniGaleri"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_circle"
                android:elevation="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="11dp"
                android:text="🖼️"
                android:textSize="22sp" />
        </FrameLayout>

        <!-- Mini buton: Kamera -->
        <FrameLayout
            android:id="@+id/btnMiniKamera"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_circle"
                android:elevation="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="11dp"
                android:text="📸"
                android:textSize="22sp" />
        </FrameLayout>

        <!-- Liquid-glass tarzı ana buton -->
        <FrameLayout
            android:id="@+id/btnEkle"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:clickable="true"
            android:focusable="true">

            <!-- Dış yumuşak renkli hale -->
            <View
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_glow_outer" />

            <!-- İç renkli hale -->
            <View
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_glow_inner" />

            <!-- Alt-sağ 3B gölge yastığı -->
            <View
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:layout_marginStart="4dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glass_pillow_shadow" />

            <!-- Cam gövde -->
            <View
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_glass_circle"
                android:elevation="12dp" />

            <!-- Üst-sol parlaklık vurgusu -->
            <View
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_glass_highlight"
                android:elevation="13dp" />

            <TextView
                android:id="@+id/tvEkleIkon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:elevation="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="↗"
                android:textColor="#4B5568"
                android:textSize="30sp" />
        </FrameLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
